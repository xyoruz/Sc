#!/bin/bash
# ============================================================
# trialvless - Create Trial Vless (durasi menit)
# Lokasi: /usr/local/sbin/trialvless
# ============================================================

BASE="/usr/local/sbin/xyr"
source "$BASE/lib/config.sh"
source "$BASE/lib/common.sh"
source "$BASE/lib/validate.sh"
source "$BASE/lib/xray-helper.sh"

require_root

print_header "TRIAL VLESS ACCOUNT"

domain=$(get_domain)
[[ -z "$domain" ]] && { print_error "Domain belum di-set"; back_to_menu; exit 1; }

ask_number MINUTES "Durasi trial (menit)" 1 1440 60

USER="trial$(tr -dc 0-9 </dev/urandom | head -c5)"
uuid=$(cat /proc/sys/kernel/random/uuid)
exp_date=$(date -d "+1 day" +"%Y-%m-%d")

xray_backup_config
sed -i "/#vless\$/a\\#& ${USER} ${exp_date}\\
},{\"id\": \"${uuid}\",\"email\": \"${USER}\"" "$XRAY_CONF"
sed -i "/#vlessgrpc\$/a\\#& ${USER} ${exp_date}\\
},{\"id\": \"${uuid}\",\"email\": \"${USER}\"" "$XRAY_CONF"

if ! xray_apply; then
    print_error "Gagal create trial"
    back_to_menu; exit 1
fi

db_save_user "$DB_VLESS" "$PREFIX_VLESS" "$USER" "$exp_date" "$uuid" 0 1

# Auto-delete
if command -v at >/dev/null 2>&1; then
    echo "/usr/local/sbin/del-auto vless ${USER}" | at now +"$MINUTES" minutes 2>/dev/null || true
fi

LINK_TLS="vless://${uuid}@${domain}:443?path=%2Fvless&security=tls&encryption=none&type=ws&host=${domain}&sni=${domain}#${USER}"

log_info "Trial Vless: $USER (${MINUTES}m)"

clear
print_line
print_title "        TRIAL VLESS DIBUAT"
print_line
echo "Username  : $USER"
echo "UUID      : $uuid"
echo "Durasi    : $MINUTES menit"
print_line
echo "Link TLS  : $LINK_TLS"
print_line
print_warn "Akun dihapus otomatis dalam $MINUTES menit"
print_line

back_to_menu