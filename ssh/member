#!/bin/bash
# ============================================================
# member - List semua user SSH
# Lokasi: /usr/local/sbin/member
# ============================================================

BASE="/usr/local/sbin/xyr"
source "$BASE/lib/config.sh"
source "$BASE/lib/common.sh"

require_root

clear
print_line
print_title "               DAFTAR USER SSH"
print_line
printf "%-20s %-22s %-10s %s\n" "USERNAME" "EXPIRED" "STATUS" "QUOTA"
print_line

total=0
while IFS=: read -r uname _ uid _; do
    [[ "$uid" -lt 1000 ]] && continue
    [[ "$uname" == "nobody" ]] && continue

    exp=$(chage -l "$uname" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
    st=$(passwd -S "$uname" 2>/dev/null | awk '{print $2}')
    [[ "$st" == "L" ]] && status="LOCKED" || status="AKTIF"

    # Quota
    if [[ -f "$QUOTA_DIR/ssh/$uname" ]]; then
        bytes=$(cat "$QUOTA_DIR/ssh/$uname" 2>/dev/null || echo 0)
        quota=$(human_size "$bytes")
    else
        quota="-"
    fi

    printf "%-20s %-22s %-10s %s\n" "$uname" "$exp" "$status" "$quota"
    total=$((total + 1))
done < /etc/passwd

print_line
echo "  Total user SSH : $total"
print_line
back_to_menu