#!/bin/bash
# ============================================================
# m-utility - Sub-menu Utility
# Lokasi: /usr/local/sbin/m-utility
# ============================================================

BASE="/usr/local/sbin/xyr"
source "$BASE/lib/config.sh"
source "$BASE/lib/common.sh"

require_root

clear
echo -e "${C_CYAN}════════════════════════════════════════════════════════${C_RESET}"
echo -e "                ${C_YELLOW}MENU UTILITY${C_RESET}"
echo -e "${C_CYAN}════════════════════════════════════════════════════════${C_RESET}"
echo ""
echo -e "   ${C_YELLOW}[1]${C_RESET}   Setting Domain + SSL"
echo -e "   ${C_YELLOW}[2]${C_RESET}   Cek Service (Health Check)"
echo -e "   ${C_YELLOW}[3]${C_RESET}   Auto Delete User Expired (xp)"
echo -e "   ${C_YELLOW}[4]${C_RESET}   Auto Reboot Scheduler"
echo -e "   ${C_YELLOW}[5]${C_RESET}   Clear Log"
echo -e "   ${C_YELLOW}[6]${C_RESET}   Clear Cache RAM"
echo -e "   ${C_YELLOW}[7]${C_RESET}   Bandwidth Monitor (vnstat)"
echo -e "   ${C_YELLOW}[8]${C_RESET}   Speedtest"
echo -e "   ${C_YELLOW}[9]${C_RESET}   Info Port & Service"
echo -e "   ${C_YELLOW}[10]${C_RESET}  Info Server"
echo -e "   ${C_YELLOW}[11]${C_RESET}  Update Script dari GitHub"
echo -e "   ${C_YELLOW}[12]${C_RESET}  Install UDP Custom (BadVPN)"
echo -e "   ${C_YELLOW}[13]${C_RESET}  Install UDP Custom (Port Range)"
echo -e "   ${C_YELLOW}[14]${C_RESET}  Uninstall UDP Custom"
echo ""
echo -e "   ${C_RED}[0]${C_RESET}   Kembali ke Menu Utama"
echo ""
echo -e "${C_GRAY}────────────────────────────────────────────────────────${C_RESET}"
read -rp "   Pilih menu [1-14 atau 0]: " opt

case "$opt" in
    1)  clear; addhost ;;
    2)  clear; healthcheck ;;
    3)  clear; xp; back_to_menu ;;
    4)  clear; autoreboot ;;
    5)  clear; clearlog ;;
    6)  clear; clearcache ;;
    7)  clear; bw ;;
    8)  clear; speedtest ;;
    9)  clear; prot ;;
    10) clear; info ;;
    11) clear; wget -q "https://raw.githubusercontent.com/<user>/<repo>/main/update.sh" -O /root/update.sh && chmod +x /root/update.sh && /root/update.sh ;;
    12) clear; install-udp ;;
    13) clear; install-udp-custom ;;
    14) clear; uninstall-udp ;;
    0)  clear; menu ;;
    *)  m-utility ;;
esac
