#!/bin/bash
# ============================================================
# delss - Delete Shadowsocks Account
# Lokasi: /usr/local/sbin/delss
# ============================================================

BASE="/usr/local/sbin/xyr"
source "$BASE/lib/config.sh"
source "$BASE/lib/common.sh"
source "$BASE/lib/xray-helper.sh"

require_root
acquire_lock "$LOCKFILE_DEL"

print_header "DELETE SHADOWSOCKS ACCOUNT"

if [[ -f "$DB_SS" ]]; then
    printf "%-20s %s\n" "USERNAME" "EXPIRED"
    print_line
    awk -v p="$PREFIX_SS" '$1==p {printf "%-20s %s\n", $2, $3}' "$DB_SS"
    print_line
else
    print_warn "DB Shadowsocks kosong"
    release_lock; back_to_menu; exit 0
fi
echo ""

while :; do
    read -rp "Username yang akan dihapus: " USER
    [[ -z "$USER" ]] && { print_warn "Dibatalkan"; release_lock; back_to_menu; exit 0; }
    if ! grep -qw "$USER" "$XRAY_CONF" 2>/dev/null; then
        print_error "User tidak ditemukan"; continue
    fi
    break
done

xray_backup_config
xray_del_user "$PREFIX_SS" "$USER"

if ! xray_apply; then
    print_error "Gagal hapus. Rollback."
    release_lock; back_to_menu; exit 1
fi

db_del_user "$DB_SS" "$PREFIX_SS" "$USER"
rm -f "${QUOTA_DIR}/ss/${USER}"
rm -f "${LIMITIP_DIR}/ss/${USER}"
rm -f "${USAGE_DIR}/ss/${USER}"
rm -f "${LOCKED_DIR}/ss/${USER}"
rm -f "${NGINX_WEB}/sodosokws-${USER}.txt"
rm -f "${NGINX_WEB}/sodosokgrpc-${USER}.txt"

log_info "Shadowsocks deleted: $USER"

print_ok "User $USER berhasil dihapus"
release_lock
back_to_menu