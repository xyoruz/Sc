#!/bin/bash
# ============================================================
# prot - Info port & service
# Lokasi: /usr/local/sbin/prot
# ============================================================

BASE="/usr/local/sbin/xyr"
source "$BASE/lib/config.sh"
source "$BASE/lib/common.sh"

clear
print_line
print_title "           PORT & SERVICE INFO"
print_line
cat <<EOF
   ${C_CYAN}SSH / OpenVPN${C_RESET}
     - OpenSSH        : 22
     - Dropbear       : 109, 143
     - OVPN TCP       : 1194
     - OVPN UDP       : 2200

   ${C_CYAN}UDP Custom${C_RESET}
     - BadVPN UDP 1   : 7100
     - BadVPN UDP 2   : 7200
     - BadVPN UDP 3   : 7300
     - UDP Custom     : 1-65535 (exclude port aktif)

   ${C_CYAN}Xray${C_RESET}
     - Vmess WS TLS   : 443
     - Vmess WS NTLS  : 80, 8080
     - Vmess gRPC     : 443
     - Vless WS TLS   : 443
     - Vless gRPC     : 443
     - Trojan WS      : 443
     - Trojan gRPC    : 443
     - Shadowsocks WS : 443
     - Shadowsocks gRPC: 443

   ${C_CYAN}Nginx${C_RESET}
     - HTTP           : 80, 81
     - HTTPS          : 443

   ${C_CYAN}HAProxy${C_RESET} (opsional)
     - SSH SSL        : 8443
     - Xray TLS       : 2053
     - Xray NTLS      : 2082, 8080
EOF
print_line
back_to_menu
